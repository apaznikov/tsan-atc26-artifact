From 316cc8673c1368b769ffa713b48a153575490b83 Mon Sep 17 00:00:00 2001
From: Alexey Paznikov <apaznikov@gmail.com>
Date: Mon, 14 Sep 2026 19:59:36 +0800
Subject: EA: a library call that stores a pointer to its argument through
 another argument (shape 22)

---
 .../include/llvm/Analysis/TargetLibraryInfo.h |  8 ++
 llvm/lib/Analysis/EscapeAnalysis.cpp          | 26 +++++-
 llvm/lib/Analysis/TargetLibraryInfo.cpp       | 16 ++++
 .../Instrumentation/ThreadSanitizer.cpp       | 15 +++
 .../escape-libcall-out-pointer.ll             | 93 +++++++++++++++++++
 5 files changed, 155 insertions(+), 3 deletions(-)
 create mode 100644 llvm/test/Instrumentation/ThreadSanitizerNew/escape-libcall-out-pointer.ll

diff --git a/llvm/include/llvm/Analysis/TargetLibraryInfo.h b/llvm/include/llvm/Analysis/TargetLibraryInfo.h
index 574cbdd6edbc..80a1b11426f8 100644
--- a/llvm/include/llvm/Analysis/TargetLibraryInfo.h
+++ b/llvm/include/llvm/Analysis/TargetLibraryInfo.h
@@ -454,6 +454,14 @@ public:
   /// earlier call was given (strtok, ctermid, realpath with a null buffer).
   static bool returnsPointerIntoArg(LibFunc F, unsigned &ArgNo);
 
+  /// True when a call to \p F stores a pointer into the memory its argument
+  /// \p SrcArg points to through its argument \p DstArg -- strtol's end
+  /// pointer: `*end = s + k`. For the escape analysis that is the store
+  /// `*DstArg = SrcArg`, so what DstArg names now points into SrcArg's
+  /// object and publishing it publishes the object.
+  static bool storesArgThroughArg(LibFunc F, unsigned &SrcArg,
+                                  unsigned &DstArg);
+
   static bool isLockAcquireFunction(const Function &F);
   static bool isLockReleaseFunction(const Function &F);
 
diff --git a/llvm/lib/Analysis/EscapeAnalysis.cpp b/llvm/lib/Analysis/EscapeAnalysis.cpp
index b4126f03c866..c988daa02715 100644
--- a/llvm/lib/Analysis/EscapeAnalysis.cpp
+++ b/llvm/lib/Analysis/EscapeAnalysis.cpp
@@ -981,9 +981,29 @@ EscapeAnalysisInfo::getEscInfoCall(const Use &U, const Instruction *I) const {
     const unsigned ArgIndex = Call->getArgOperandNo(&U);
     // Some functions can be taken as safe external calls
     LibFunc Func;
-    if (TLI.getLibFunc(*CalledFunc, Func) && TLI.has(Func) &&
-        !TLI.doesArgEscape(Func, ArgIndex))
-      return {EscKindTy::NO_ESCAPE, std::nullopt};
+    if (TLI.getLibFunc(*CalledFunc, Func) && TLI.has(Func)) {
+      // strtol(s, &end, base) stores a pointer into s through end. That is
+      // the store `*end = s` as far as escaping goes: the slot now points
+      // into s's object, and publishing what the slot holds publishes the
+      // object. The table said only that s is not retained, so
+      // `strtol(buf, &end, 10); g = end;` left buf local and its later
+      // accesses unprotected while a thread wrote it through g (shape 22).
+      // A null end pointer stores nothing.
+      if (unsigned Src, Dst; TargetLibraryInfo::storesArgThroughArg(Func, Src, Dst) &&
+          ArgIndex == Src && Dst < Call->arg_size() &&
+          !isa<ConstantPointerNull>(
+              Call->getArgOperand(Dst)->stripPointerCasts())) {
+        bool DstComplete = true;
+        const auto DstObjs =
+            getUnderlyingMayEscObjs(Call->getArgOperand(Dst), TLI,
+                                    MaxUnderlObjLookup, nullptr, &DstComplete);
+        if (!DstComplete || DstObjs.empty())
+          return {EscKindTy::MAY_ESCAPE, EscReasonBits::OTHER};
+        return {EscKindTy::MAY_ALIASING, DstObjs};
+      }
+      if (!TLI.doesArgEscape(Func, ArgIndex))
+        return {EscKindTy::NO_ESCAPE, std::nullopt};
+    }
 
     if (isSafeExternalCall(CalledFunc->getName(), TLI, ArgIndex,
                            NonEscapingFuncs))
diff --git a/llvm/lib/Analysis/TargetLibraryInfo.cpp b/llvm/lib/Analysis/TargetLibraryInfo.cpp
index ce18d017a0f4..dabe773e5471 100644
--- a/llvm/lib/Analysis/TargetLibraryInfo.cpp
+++ b/llvm/lib/Analysis/TargetLibraryInfo.cpp
@@ -1761,6 +1761,22 @@ bool TargetLibraryInfo::returnsPointerIntoArg(LibFunc F, unsigned &ArgNo) {
   }
 }
 
+bool TargetLibraryInfo::storesArgThroughArg(LibFunc F, unsigned &SrcArg,
+                                            unsigned &DstArg) {
+  switch (F) {
+  // The conversion stops somewhere inside the string; the position is
+  // stored through the end pointer when one is given.
+  case LibFunc_strtol: case LibFunc_strtoll:
+  case LibFunc_strtoul: case LibFunc_strtoull:
+  case LibFunc_strtod: case LibFunc_strtof: case LibFunc_strtold:
+    SrcArg = 0;
+    DstArg = 1;
+    return true;
+  default:
+    return false;
+  }
+}
+
 bool TargetLibraryInfo::isReturnValueEscaping(LibFunc F) {
   switch (F) {
   // ===================================================================
diff --git a/llvm/lib/Transforms/Instrumentation/ThreadSanitizer.cpp b/llvm/lib/Transforms/Instrumentation/ThreadSanitizer.cpp
index 3ceac225cb3e..38a6119e6335 100644
--- a/llvm/lib/Transforms/Instrumentation/ThreadSanitizer.cpp
+++ b/llvm/lib/Transforms/Instrumentation/ThreadSanitizer.cpp
@@ -1280,6 +1280,21 @@ collectLaterEscapes(Instruction *Access, Value *Addr,
         if (getArgumentAliasingToReturnedPointer(CB, false) == U.get() ||
             EscapeAnalysisInfo::getLibCallArgReturnedInto(CB, TLI) == U.get())
           Work.push_back(CB);
+        // A library call that stores a pointer into this argument through
+        // another argument (strtol's end pointer) is a store of the address
+        // into that slot, and is classified as one: a local slot is not
+        // followed (kept), a global slot is a plain publication (shape 22).
+        if (const Function *LibCallee = CB->getCalledFunction()) {
+          LibFunc LF;
+          unsigned Src, Dst;
+          if (TLI.getLibFunc(*LibCallee, LF) && TLI.has(LF) &&
+              TargetLibraryInfo::storesArgThroughArg(LF, Src, Dst) &&
+              ArgNo == Src && Dst < CB->arg_size() &&
+              !isa<ConstantPointerNull>(
+                  CB->getArgOperand(Dst)->stripPointerCasts()))
+            ClassifyStoreTo(CB->getArgOperand(Dst), CB, /*Atomic=*/false,
+                            AtomicOrdering::NotAtomic);
+        }
         if (CB->doesNotCapture(ArgNo) || !Reachable(CB))
           continue;
         const Function *Callee = CB->getCalledFunction();
diff --git a/llvm/test/Instrumentation/ThreadSanitizerNew/escape-libcall-out-pointer.ll b/llvm/test/Instrumentation/ThreadSanitizerNew/escape-libcall-out-pointer.ll
new file mode 100644
index 000000000000..e3174604f9d4
--- /dev/null
+++ b/llvm/test/Instrumentation/ThreadSanitizerNew/escape-libcall-out-pointer.ll
@@ -0,0 +1,93 @@
+; strtol(s, &end, base) stores a pointer into s through end. The library
+; table said only that s is not retained, so the slot never pointed into the
+; buffer: `strtol(buf, &end, 10); g = end;` left buf local and its later
+; accesses were elided while a thread wrote it through g (shape 22). The call
+; is now the store `*end = s` for the escape analysis and a store site for
+; the later-escape rule. Controls: a null end pointer stores nothing
+; (@strtol_endptr_null), an end pointer that is only compared publishes
+; nothing (@strtol_endptr_private).
+
+; RUN: opt < %s -passes='module(tsan-module),function(tsan)' -tsan-use-escape-analysis-global -S | FileCheck %s
+
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+
+@g = global ptr null, align 8
+declare i64 @strtol(ptr, ptr, i32)
+declare double @strtod(ptr, ptr)
+declare void @use(i1)
+
+; The slot's content is published after the conversion: the write to the
+; buffer after that is instrumented.
+define void @strtol_endptr_published() sanitize_thread {
+; CHECK-LABEL: @strtol_endptr_published
+; CHECK:       store ptr %e, ptr @g
+; CHECK:       call void @__tsan_write1(ptr %b)
+; CHECK-NEXT:  store i8 1, ptr %b
+  %b = alloca [8 x i8], align 1
+  %endp = alloca ptr, align 8
+  store i8 49, ptr %b, align 1
+  %v = call i64 @strtol(ptr %b, ptr %endp, i32 10)
+  %e = load ptr, ptr %endp, align 8
+  store ptr %e, ptr @g, align 8
+  store i8 1, ptr %b, align 1
+  ret void
+}
+
+; The publication comes after the access: the conversion's store into the
+; local slot is a site the later-escape rule keeps.
+define void @strtol_endptr_published_later() sanitize_thread {
+; CHECK-LABEL: @strtol_endptr_published_later
+; CHECK:       call void @__tsan_write1(ptr %b)
+; CHECK-NEXT:  store i8 1, ptr %b
+; CHECK:       store ptr %e, ptr @g
+  %b = alloca [8 x i8], align 1
+  %endp = alloca ptr, align 8
+  %v = call i64 @strtol(ptr %b, ptr %endp, i32 10)
+  store i8 1, ptr %b, align 1
+  %e = load ptr, ptr %endp, align 8
+  store ptr %e, ptr @g, align 8
+  ret void
+}
+
+; strtod, the same shape.
+define void @strtod_endptr_published() sanitize_thread {
+; CHECK-LABEL: @strtod_endptr_published
+; CHECK:       store ptr %e, ptr @g
+; CHECK:       call void @__tsan_write1(ptr %b)
+; CHECK-NEXT:  store i8 1, ptr %b
+  %b = alloca [8 x i8], align 1
+  %endp = alloca ptr, align 8
+  %v = call double @strtod(ptr %b, ptr %endp)
+  %e = load ptr, ptr %endp, align 8
+  store ptr %e, ptr @g, align 8
+  store i8 1, ptr %b, align 1
+  ret void
+}
+
+; Control: a null end pointer stores nothing; the buffer stays local.
+define void @strtol_endptr_null() sanitize_thread {
+; CHECK-LABEL: @strtol_endptr_null
+; CHECK-NOT:   call void @__tsan_write1(ptr %b)
+; CHECK:       ret void
+  %b = alloca [8 x i8], align 1
+  store i8 49, ptr %b, align 1
+  %v = call i64 @strtol(ptr %b, ptr null, i32 10)
+  store i8 1, ptr %b, align 1
+  ret void
+}
+
+; Control: the end pointer is only compared; nothing is published.
+define void @strtol_endptr_private() sanitize_thread {
+; CHECK-LABEL: @strtol_endptr_private
+; CHECK-NOT:   call void @__tsan_write1(ptr %b)
+; CHECK:       ret void
+  %b = alloca [8 x i8], align 1
+  %endp = alloca ptr, align 8
+  store i8 49, ptr %b, align 1
+  %v = call i64 @strtol(ptr %b, ptr %endp, i32 10)
+  %e = load ptr, ptr %endp, align 8
+  %c = icmp eq ptr %e, %b
+  call void @use(i1 %c)
+  store i8 1, ptr %b, align 1
+  ret void
+}
