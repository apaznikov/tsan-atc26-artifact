+++ b/llvm/include/llvm/Analysis/TargetLibraryInfo.h
@@ -448,6 +448,10 @@ public:
   static bool isLockAcquireFunction(const Function &F);
   static bool isLockReleaseFunction(const Function &F);
 
+  /// Whether the library function \p F is known not to synchronise with other
+  /// threads: no lock, no descriptor or stream, no callback into the program.
+  /// Answered from an explicit list; a function the list does not name is
+  /// reported as if it synchronises.
   bool isSyncFree(LibFunc F) const;
 
   StringRef getName(LibFunc F) const {
