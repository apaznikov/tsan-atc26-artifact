From e6c585820dd978ec40cd2b1b2c7800f718abf0a4 Mon Sep 17 00:00:00 2001
From: Alexey Paznikov <apaznikov@gmail.com>
Date: Mon, 14 Sep 2026 19:59:29 +0800
Subject: Repair the runtime and test builds; make the suite runnable per
 analysis configuration

---
 compiler-rt/lib/tsan/go/buildgo.sh            |  1 +
 compiler-rt/lib/tsan/rtl/tsan_filter.cpp      | 20 +++++++++++++
 compiler-rt/lib/tsan/rtl/tsan_rtl.h           | 28 +++++++++----------
 compiler-rt/test/tsan/ReXFilter/lit.local.cfg |  6 ++++
 compiler-rt/test/tsan/lit.cfg.py              | 20 +++++++++----
 .../ThreadSanitizerNew/peeling.ll             |  5 +++-
 6 files changed, 60 insertions(+), 20 deletions(-)
 create mode 100644 compiler-rt/test/tsan/ReXFilter/lit.local.cfg

diff --git a/compiler-rt/lib/tsan/go/buildgo.sh b/compiler-rt/lib/tsan/go/buildgo.sh
index 78ba41a0bdc6..f593d36b817c 100755
--- a/compiler-rt/lib/tsan/go/buildgo.sh
+++ b/compiler-rt/lib/tsan/go/buildgo.sh
@@ -46,6 +46,7 @@ SUFFIX="${GOOS}_${GOARCH}"
 SRCS="
 	tsan_go.cpp
 	../rtl/tsan_external.cpp
+	../rtl/tsan_filter.cpp
 	../rtl/tsan_flags.cpp
 	../rtl/tsan_interface_atomic.cpp
 	../rtl/tsan_md5.cpp
diff --git a/compiler-rt/lib/tsan/rtl/tsan_filter.cpp b/compiler-rt/lib/tsan/rtl/tsan_filter.cpp
index 555446375157..857db213adc1 100644
--- a/compiler-rt/lib/tsan/rtl/tsan_filter.cpp
+++ b/compiler-rt/lib/tsan/rtl/tsan_filter.cpp
@@ -18,6 +18,22 @@
 
 namespace __tsan {
 
+// Out of line so that DenseMap's internals -- and the placement new they need
+// -- are instantiated here rather than in every includer of tsan_rtl.h.
+LocksetContext::LocksetContext() = default;
+LocksetContext::~LocksetContext() = default;
+
+void LocksetContext::process_lock(uptr addr) { ++internal_ctx[addr]; }
+
+void LocksetContext::process_unlock(uptr addr) {
+  auto *bucket = internal_ctx.find(addr);
+  if (bucket) {
+    bucket->second--;
+    if (bucket->second == 0)
+      internal_ctx.erase(bucket);
+  }
+}
+
 //=============================== Statistics =================================//
 
 // Total number of memory accesses processed by the filter.
@@ -421,9 +437,13 @@ void FilterHistory::PrintStats(ThreadState *thr) {
   // Print top 10 or less if there are fewer entries
   for (usize i = 0; i < sorted_stats.size() && i < 10; i++) {
     Printf("-------------------------------------------------\n");
+#if !SANITIZER_GO
+    // The Go runtime is built without the symbolizer, so it has no
+    // StackTrace::Print to link against.
     VarSizeStackTrace stack;
     ObtainCurrentStack(thr, sorted_stats[i].first, &stack);
     stack.Print();
+#endif
     // Printf("  #%lu: PC=%p\t", i + 1, (void*)sorted_stats[i].first);
     Printf("Filtered %llu times\n", sorted_stats[i].second);
     Printf("-------------------------------------------------\n");
diff --git a/compiler-rt/lib/tsan/rtl/tsan_rtl.h b/compiler-rt/lib/tsan/rtl/tsan_rtl.h
index 3f4e409a5fd9..d2111833ce6e 100644
--- a/compiler-rt/lib/tsan/rtl/tsan_rtl.h
+++ b/compiler-rt/lib/tsan/rtl/tsan_rtl.h
@@ -49,8 +49,8 @@
 #include "tsan_trace.h"
 #include "tsan_vector_clock.h"
 
-// Needed for DenseMap
-#include "sanitizer_common/sanitizer_placement_new.h"
+// DenseMap, for the ReX filter's per-thread lockset below.
+#include "sanitizer_common/sanitizer_dense_map.h"
 
 // Variable to track ST/MT context in runtime
 extern "C" SANITIZER_INTERFACE_ATTRIBUTE volatile __sanitizer::atomic_uint32_t
@@ -163,20 +163,20 @@ struct TidSlot {
   TidSlot();
 } ALIGNED(SANITIZER_CACHE_LINE_SIZE);
 
-// ReX redundancy filter implementation - lockset optimization
+// ReX redundancy filter implementation - lockset optimization.
+//
+// The methods are deliberately out of line. Defining them here instantiated
+// DenseMap's internals in every translation unit that includes this header,
+// which in turn needed sanitizer_placement_new.h here -- and that header says,
+// in as many words, not to include it from a header. Doing so redeclared
+// operator new without noexcept and broke every build that also sees
+// libstdc++'s <new>, the TSan unit tests among them.
 struct LocksetContext {
-  void process_lock(uptr addr) {
-    ++internal_ctx[addr];
-  }
+  LocksetContext();
+  ~LocksetContext();
 
-  void process_unlock(uptr addr) {
-    auto *bucket = internal_ctx.find(addr);
-    if (bucket) {
-      bucket->second--;
-      if (bucket->second == 0)
-        internal_ctx.erase(bucket);
-    }
-  }
+  void process_lock(uptr addr);
+  void process_unlock(uptr addr);
 
   DenseMap<uptr, int> internal_ctx;
 };
diff --git a/compiler-rt/test/tsan/ReXFilter/lit.local.cfg b/compiler-rt/test/tsan/ReXFilter/lit.local.cfg
new file mode 100644
index 000000000000..bffa2f1408b5
--- /dev/null
+++ b/compiler-rt/test/tsan/ReXFilter/lit.local.cfg
@@ -0,0 +1,6 @@
+# The ReX filter tests are standalone programs driven by the scripts in this
+# directory (compile_all_tests.sh, run.sh, run_until_no_race.sh), not by lit:
+# several need to be run repeatedly until a racy schedule appears, and the
+# filter itself is compiled out unless _REX_FILTER_ENABLED is defined. They
+# carry no RUN lines, so lit discovering them only ever reported failures.
+config.suffixes = []
diff --git a/compiler-rt/test/tsan/lit.cfg.py b/compiler-rt/test/tsan/lit.cfg.py
index 54dd0fbb91f8..682067557e1d 100644
--- a/compiler-rt/test/tsan/lit.cfg.py
+++ b/compiler-rt/test/tsan/lit.cfg.py
@@ -47,9 +47,20 @@ if config.compiler_id == "GNU":
 else:
     extra_cflags = []
 
-# Enable new Escape Analysis instead of default Capture Tracking
-#escape_analysis_flag = ["-mllvm -tsan-use-escape-analysis"]
-escape_analysis_flag = ["-mllvm -tsan-use-escape-analysis-global"]
+# Instrumentation-pass options this fork's analyses are gated behind. The suite
+# is the preservation corpus for those analyses, so which ones are enabled must
+# be selectable rather than hard-coded: it is the difference between validating
+# one analysis and validating a configuration.
+#
+#   TSAN_MLLVM_FLAGS="-tsan-use-single-threaded -tsan-use-swmr" ninja check-tsan
+#   TSAN_MLLVM_FLAGS="" ninja check-tsan            # stock TSan, no analyses
+#
+# Defaults to the global escape analysis, preserving the previous behaviour.
+tsan_analysis_flags = []
+for _flag in os.environ.get(
+    "TSAN_MLLVM_FLAGS", "-tsan-use-escape-analysis-global"
+).split():
+    tsan_analysis_flags.append("-mllvm %s" % _flag)
 
 tsan_incdir = config.test_source_root + "/../"
 # Setup default compiler flags used with -fsanitize=thread option.
@@ -59,11 +70,10 @@ clang_tsan_cflags = (
     + config.debug_info_flags
     + extra_cflags
     + ["-I%s" % tsan_incdir]
-    + escape_analysis_flag
+    + tsan_analysis_flags
 )
 clang_tsan_cxxflags = (
     config.cxx_mode_flags + clang_tsan_cflags + ["-std=c++11"] + ["-I%s" % tsan_incdir]
-    + escape_analysis_flag
 )
 # Add additional flags if we're using instrumented libc++.
 # Instrumented libcxx currently not supported on Darwin.
diff --git a/llvm/test/Instrumentation/ThreadSanitizerNew/peeling.ll b/llvm/test/Instrumentation/ThreadSanitizerNew/peeling.ll
index 30d214378a94..535f39011804 100644
--- a/llvm/test/Instrumentation/ThreadSanitizerNew/peeling.ll
+++ b/llvm/test/Instrumentation/ThreadSanitizerNew/peeling.ll
@@ -1,4 +1,7 @@
-; RUN: opt < %s -passes=tsan -tsan-use-dominance-analysis=true -tsan-use-loop-peeling=true -S | FileCheck %s
+; Peeling runs in the module pass, so the pipeline has to include it -- with
+; only the function pass, no loop is ever peeled and the test below can never
+; have been exercising peeling at all.
+; RUN: opt < %s -passes='module(tsan-module),function(tsan)' -tsan-use-dominance-analysis=true -tsan-use-loop-peeling=true -S | FileCheck %s
 
 target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
 target triple = "x86_64-unknown-linux-gnu"
