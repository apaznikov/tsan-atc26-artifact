+; ALONE-LABEL: Unclassified Functions
+; SEEDED-LABEL: Multi-Threaded Functions
+; SEEDED-NOT: after_helper
+; SEEDED-LABEL: Single-Threaded Functions
+; SEEDED: after_helper
+; SEEDED-LABEL: Unclassified Functions
+
+;--- a.ll
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+@g = global i32 0, align 4
+declare i32 @pthread_create(ptr, ptr, ptr, ptr)
+declare void @helper()
+define internal void @after_helper() {
+  store i32 1, ptr @g, align 4
+  ret void
+}
+define internal ptr @worker(ptr %a) {
+  store i32 2, ptr @g, align 4
+  ret ptr null
+}
+define i32 @main() {
+  %t = alloca i64, align 8
+  call void @helper()
+  call void @after_helper()
+  %c = call i32 @pthread_create(ptr %t, ptr null, ptr @worker, ptr null)
+  ret i32 0
+}
+
+;--- b.ll
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+@g = external global i32, align 4
+define void @helper() {
+  %v = load i32, ptr @g, align 4
+  ret void
+}
diff --git a/llvm/test/Analysis/SingleThreaded/unknown-external.ll b/llvm/test/Analysis/SingleThreaded/unknown-external.ll
new file mode 100644
index 000000000000..8bc662cb719b
--- /dev/null
+++ b/llvm/test/Analysis/SingleThreaded/unknown-external.ll
@@ -0,0 +1,295 @@
+; A call to a function this module has no body for may start a thread, and
+; so may an indirect call, inline asm, or a callback carrier handed a callback
+; that starts one. Before this, a bodiless callee was classified
+; multi-threaded (it runs somewhere) but never as a creator, so the caller
+; stayed single-threaded and its accesses after the call -- the ones that
+; race with the thread just started in another unit -- were left
+; uninstrumented. The exemptions are exact: intrinsics, library functions
+; TargetLibraryInfo knows by name and prototype, an allowlist of POSIX and
+; runtime names, closed runtime families by prefix, namespace std minus its
+; thread starters, and callback carriers whose callback is a constant that
+; does not itself create threads. The same verdicts hold under
+; -tsan-whole-program.
+
+; RUN: opt < %s -passes='print<single-threaded>' -disable-output 2>&1 | FileCheck %s
+; RUN: opt < %s -passes='print<single-threaded>' -disable-output -tsan-whole-program 2>&1 | FileCheck %s
+
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+
+@slot = global ptr null, align 8
+@once = global i32 0, align 4
+@buf = global [4 x i32] zeroinitializer, align 4
+@sa = global [16 x i64] zeroinitializer, align 8
+@fmt = private constant [3 x i8] c"x\0A\00"
+
+declare i32 @pthread_create(ptr, ptr, ptr, ptr)
+declare void @start_worker()
+; strlen with the wrong prototype: not the library function, an unknown.
+declare void @strlen()
+declare void @_ZNSt13__future_base12_State_baseV27_M_waitEv(ptr)
+declare void @qsort(ptr, i64, i64, ptr)
+declare i32 @pthread_once(ptr, ptr)
+declare i32 @timer_create(i32, ptr, ptr)
+declare ptr @dlopen(ptr, i32)
+declare i32 @sigaction(i32, ptr, ptr)
+declare void @__kmpc_fork_call_if(ptr, i32, ptr, i32, ptr)
+declare token @llvm.experimental.gc.statepoint.p0(i64, i32, ptr, i32, i32, ...)
+declare i32 @ext_cmp(ptr, ptr)
+declare i32 @printf(ptr, ...)
+declare i32 @pthread_join(i64, ptr)
+declare i32 @pthread_mutex_lock(ptr)
+declare void @_ZNSt8ios_base4InitC1Ev(ptr)
+declare ptr @_ZNSolsEi(ptr, i32)
+declare void @_ZNSt6thread4joinEv(ptr)
+; A const member, a substitution (std::string's old ABI, Ss) and two thunks
+; of a std class: all namespace std by mangling.
+declare i64 @_ZNKSt6vectorIiSaIiEE4sizeEv(ptr)
+declare i64 @_ZNKSs4sizeEv(ptr)
+declare void @_ZThn16_NSt9basic_iosIcSt11char_traitsIcEED1Ev(ptr)
+declare void @_ZTv0_n24_NSt9basic_iosIcSt11char_traitsIcEED1Ev(ptr)
+declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
+declare void @__tsan_testonly_barrier_init(ptr, i32)
+declare i32 @posix_spawn(ptr, ptr, ptr, ptr, ptr, ptr)
+declare i32 @fork()
+declare i32 @__printf_chk(i32, ptr, ...)
+declare i32 @omp_get_num_threads()
+declare ptr @signal(i32, ptr)
+declare i32 @atexit(ptr)
+
+define internal ptr @worker(ptr %a) {
+  ret ptr null
+}
+
+; --- creators ---
+
+define internal void @calls_unknown() {
+  call void @start_worker()
+  ret void
+}
+define internal void @calls_wrong_proto() {
+  call void @strlen()
+  ret void
+}
+define internal void @calls_future_base() {
+  call void @_ZNSt13__future_base12_State_baseV27_M_waitEv(ptr null)
+  ret void
+}
+define internal void @calls_indirect() {
+  %fp = load ptr, ptr @slot, align 8
+  call void %fp()
+  ret void
+}
+define internal void @calls_asm() {
+  call void asm sideeffect "", ""()
+  ret void
+}
+define internal i32 @cmp_spawn(ptr %a, ptr %b) {
+  %t = alloca i64, align 8
+  %c = call i32 @pthread_create(ptr %t, ptr null, ptr @worker, ptr null)
+  ret i32 0
+}
+define internal void @qsort_spawner() {
+  call void @qsort(ptr @buf, i64 4, i64 4, ptr @cmp_spawn)
+  ret void
+}
+define internal void @qsort_runtime(ptr %c) {
+  call void @qsort(ptr @buf, i64 4, i64 4, ptr %c)
+  ret void
+}
+define internal void @qsort_extern_cb() {
+  call void @qsort(ptr @buf, i64 4, i64 4, ptr @ext_cmp)
+  ret void
+}
+define internal void @init_spawn() {
+  %t = alloca i64, align 8
+  %c = call i32 @pthread_create(ptr %t, ptr null, ptr @worker, ptr null)
+  ret void
+}
+define internal void @once_spawn() {
+  %r = call i32 @pthread_once(ptr @once, ptr @init_spawn)
+  ret void
+}
+define internal void @calls_timer_create() {
+  %r = call i32 @timer_create(i32 0, ptr null, ptr null)
+  ret void
+}
+define internal void @calls_dlopen() {
+  %h = call ptr @dlopen(ptr null, i32 0)
+  ret void
+}
+define internal void @calls_sigaction() {
+  %r = call i32 @sigaction(i32 13, ptr @sa, ptr null)
+  ret void
+}
+define internal void @calls_kmpc_fork_call_if() {
+  call void @__kmpc_fork_call_if(ptr null, i32 0, ptr @worker, i32 0, ptr null)
+  ret void
+}
+define internal void @gc_target() {
+  ret void
+}
+define internal void @calls_statepoint() gc "statepoint-example" {
+  %tok = call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 0, i32 0, ptr elementtype(void ()) @gc_target, i32 0, i32 0, i32 0, i32 0)
+  ret void
+}
+
+; --- thread-free ---
+
+define internal void @calls_printf() {
+  %r = call i32 (ptr, ...) @printf(ptr @fmt)
+  ret void
+}
+define internal void @calls_join() {
+  %r = call i32 @pthread_join(i64 0, ptr null)
+  ret void
+}
+define internal void @calls_mutex() {
+  %r = call i32 @pthread_mutex_lock(ptr @once)
+  ret void
+}
+define internal void @calls_std() {
+  call void @_ZNSt8ios_base4InitC1Ev(ptr @sa)
+  ret void
+}
+define internal void @calls_ostream() {
+  %r = call ptr @_ZNSolsEi(ptr @sa, i32 1)
+  ret void
+}
+define internal void @calls_thread_join() {
+  call void @_ZNSt6thread4joinEv(ptr @sa)
+  ret void
+}
+define internal void @std_mangling_forms() {
+  %a = call i64 @_ZNKSt6vectorIiSaIiEE4sizeEv(ptr @sa)
+  %b = call i64 @_ZNKSs4sizeEv(ptr @sa)
+  call void @_ZThn16_NSt9basic_iosIcSt11char_traitsIcEED1Ev(ptr @sa)
+  call void @_ZTv0_n24_NSt9basic_iosIcSt11char_traitsIcEED1Ev(ptr @sa)
+  ret void
+}
+define internal void @calls_intrinsic() {
+  call void @llvm.memset.p0.i64(ptr @buf, i8 0, i64 16, i1 false)
+  ret void
+}
+define internal void @calls_barrier() {
+  call void @__tsan_testonly_barrier_init(ptr @sa, i32 2)
+  ret void
+}
+define internal void @calls_posix_spawn() {
+  %r = call i32 @posix_spawn(ptr null, ptr null, ptr null, ptr null, ptr null, ptr null)
+  ret void
+}
+define internal void @calls_fork() {
+  %r = call i32 @fork()
+  ret void
+}
+define internal void @calls_chk() {
+  %r = call i32 (i32, ptr, ...) @__printf_chk(i32 1, ptr @fmt)
+  ret void
+}
+define internal void @calls_omp() {
+  %r = call i32 @omp_get_num_threads()
+  ret void
+}
+define internal i32 @cmp(ptr %a, ptr %b) {
+  ret i32 0
+}
+define internal void @qsort_st() {
+  call void @qsort(ptr @buf, i64 4, i64 4, ptr @cmp)
+  ret void
+}
+define internal void @signal_ign() {
+  %r = call ptr @signal(i32 13, ptr inttoptr (i64 1 to ptr))
+  ret void
+}
+define internal void @signal_dfl() {
+  %r = call ptr @signal(i32 2, ptr null)
+  ret void
+}
+define internal void @cleanup() {
+  ret void
+}
+define internal void @atexit_st() {
+  %r = call i32 @atexit(ptr @cleanup)
+  ret void
+}
+
+; The thread-free helpers are called first: main's single-threaded prefix
+; ends at the first creating call, and everything main calls after that is
+; multi-threaded regardless of its own body.
+define i32 @main() {
+  call void @calls_printf()
+  call void @calls_join()
+  call void @calls_mutex()
+  call void @calls_std()
+  call void @calls_ostream()
+  call void @calls_thread_join()
+  call void @std_mangling_forms()
+  call void @calls_intrinsic()
+  call void @calls_barrier()
+  call void @calls_posix_spawn()
+  call void @calls_fork()
+  call void @calls_chk()
+  call void @calls_omp()
+  call void @qsort_st()
+  call void @signal_ign()
+  call void @signal_dfl()
+  call void @atexit_st()
+  call void @calls_unknown()
+  call void @calls_wrong_proto()
+  call void @calls_future_base()
+  call void @calls_indirect()
+  call void @calls_asm()
+  call void @qsort_spawner()
+  call void @qsort_runtime(ptr @cmp)
+  call void @qsort_extern_cb()
+  call void @once_spawn()
+  call void @calls_timer_create()
+  call void @calls_dlopen()
+  call void @calls_sigaction()
+  call void @calls_kmpc_fork_call_if()
+  call void @calls_statepoint()
+  %t = alloca i64, align 8
+  %c = call i32 @pthread_create(ptr %t, ptr null, ptr @worker, ptr null)
+  ret i32 0
+}
+
