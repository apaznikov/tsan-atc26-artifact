+/// Closed runtime families: the sanitizer interfaces and annotations, the
+/// Itanium C++ ABI runtime, the unwinder, the OpenMP runtime (its fork entry
+/// points are creators and are tested first), and the ISO C99/C23 aliases
+/// glibc emits for scanf and strtol.
+constexpr StringRef ThreadFreePrefixes[] = {
+    "__tsan_", "__sanitizer_", "Annotate", "__cxa_", "_Unwind_",
+    "__kmpc_", "omp_",         "__isoc99_", "__isoc23_"};
+
+/// Members of namespace std that start a thread, or wrap something that
+/// does: std::thread's members (join, detach and hardware_concurrency
+/// excepted below), std::async and the future machinery it builds on,
+/// std::jthread. Everything else in std is a library that this unit calls
+/// into and that comes back without having started a thread.
+constexpr StringRef StdCreatorPrefixes[] = {
+    "_ZNSt6thread",      "_ZNSt3__16thread", "_ZNSt13__future_base",
+    "_ZNSt3__113__future_base", "_ZSt5async", "_ZNSt3__15async",
+    "_ZNSt7jthread",     "_ZNSt3__17jthread"};
+
+static const StringSet<> StdThreadFreeExact = {
+    "_ZNSt6thread4joinEv", "_ZNSt6thread6detachEv",
+    "_ZNSt6thread20hardware_concurrencyEv", "_ZNSt3__16thread4joinEv",
+    "_ZNSt3__16thread6detachEv", "_ZNSt3__16thread20hardware_concurrencyEv"};
