+; A project can vouch for names on top of the built-in thread-free list:
+; -tsan-thread-free-names=a,b makes a call to @a or @b not a thread creation.
+; The default answer for an unknown external stays "may create a thread", and
+; a known creator cannot be vouched away.
+
+; RUN: opt < %s -passes='print<single-threaded>' -disable-output 2>&1 | FileCheck %s --check-prefix=DEFAULT
+; RUN: opt < %s -passes='print<single-threaded>' -disable-output -tsan-thread-free-names=event_get_version,event_init,pthread_create 2>&1 | FileCheck %s --check-prefix=VOUCHED
+
+; DEFAULT-LABEL: Thread Creator Functions
+; DEFAULT-DAG: calls_libevent
+; DEFAULT-DAG: spawner
+; DEFAULT-LABEL: Multi-Threaded Functions
+; VOUCHED-LABEL: Thread Creator Functions
+; VOUCHED-NOT: calls_libevent
+; VOUCHED: spawner
+; VOUCHED-LABEL: Multi-Threaded Functions
+; VOUCHED-LABEL: Single-Threaded Functions
+; VOUCHED: calls_libevent
+; VOUCHED-LABEL: Unclassified Functions
+
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+
+declare ptr @event_get_version()
+declare ptr @event_init()
+declare i32 @pthread_create(ptr, ptr, ptr, ptr)
+
+define internal ptr @worker(ptr %a) {
+  ret ptr null
+}
+define internal void @calls_libevent() {
+  %v = call ptr @event_get_version()
+  %b = call ptr @event_init()
+  ret void
+}
+define internal void @spawner() {
+  %t = alloca i64, align 8
+  %c = call i32 @pthread_create(ptr %t, ptr null, ptr @worker, ptr null)
+  ret void
+}
+define i32 @main() {
+  call void @calls_libevent()
+  call void @spawner()
+  ret i32 0
+}
