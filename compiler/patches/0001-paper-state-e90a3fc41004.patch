+DenseMap<Instruction *, size_t> ThreadSanitizer::createInstrIndexMap(
+      SmallVectorImpl<InstructionInfo> &AllInstr) {
+  DenseMap<Instruction *, size_t> InstToIndexInAll;
+  for (size_t i = 0; i < AllInstr.size(); ++i)
