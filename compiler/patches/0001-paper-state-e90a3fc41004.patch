+; CHECK: Escaping objects for BB if.end:
+; CHECK-DAG:   %x = alloca i32, align 4
+entry:
+  %x = alloca i32, align 4
+  %0 = load ptr, ptr @GPtr, align 8
+  %cmp = icmp eq ptr %0, null
