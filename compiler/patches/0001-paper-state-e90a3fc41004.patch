+  void findFunsContainsLoops();
+  SmallDenseMap<const Function *, bool, 8> IsFuncDangerousGlobal;
+  SmallDenseMap<const Function *, bool, 8> IsFuncContainsLoops;
+  const Module &M;
+  const CallGraph &CG;
+  AnalysisManager<Function> &AM;
 };
 
