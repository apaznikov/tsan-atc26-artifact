 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/llvm/test/Analysis/SingleThreaded/unknown-external-summary.ll b/llvm/test/Analysis/SingleThreaded/unknown-external-summary.ll
index a0030bd2a3bd..01cf5e812df9 100644
