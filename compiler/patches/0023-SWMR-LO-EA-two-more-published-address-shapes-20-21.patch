+const Value *
+EscapeAnalysisInfo::getLibCallArgReturnedInto(const CallBase *Call,
+                                              const TargetLibraryInfo &TLI) {
+  const Function *Callee = Call->getCalledFunction();
+  LibFunc Func;
+  unsigned ArgNo;
+  if (!Callee || !TLI.getLibFunc(*Callee, Func) || !TLI.has(Func) ||
+      !TargetLibraryInfo::returnsPointerIntoArg(Func, ArgNo) ||
+      ArgNo >= Call->arg_size())
+    return nullptr;
+  const Value *Arg = Call->getArgOperand(ArgNo);
+  // realloc(NULL, n) is an allocation: there is no object to continue from,
+  // and null is not one (the walk drops it, and an access whose address
+  // reaches no object is judged local). The call stays an object of its own.
+  if (isa<ConstantPointerNull>(Arg->stripPointerCasts()))
+    return nullptr;
+  return Arg;
+}
