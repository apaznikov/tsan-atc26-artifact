+/// The stored lists of \p PathToPointee (a PointsToRelTy::PathToPointeeMap)
+/// whose path overlaps \p Path: how many, and the last of them.
+template <class PathToPointeeMapT, class PointeeListT>
+static unsigned countOverlappingLists(const PathToPointeeMapT &PathToPointee,
+                                      const FieldPathTy &Path,
+                                      const PointeeListT *&Only) {
+  unsigned NumMatching = 0;
+  for (const auto &[StoredPath, Pointees] : PathToPointee)
+    if (pathsOverlap(StoredPath, Path)) {
+      ++NumMatching;
+      Only = &Pointees;
+    }
+  return NumMatching;
+}
+
+void EscapeAnalysisInfo::PointsToRelTy::walkList(
+    const Value *Obj, const PointeeListTy &List,
+    function_ref<void(const ObjAndPath &)> Action) const {
+  if (List.empty())
+    return;
+  IteratingObjs.push_back(Obj);
+  for (const ObjAndPath &Pointee : List)
+    Action(Pointee);
+  IteratingObjs.pop_back();
+}
+
+void EscapeAnalysisInfo::PointsToRelTy::forEachPointee(
+    const ObjAndPath &Pointer,
+    function_ref<void(const ObjAndPath &)> Action) const {
+  const auto It = PointsToMap.find(Pointer.Obj);
+  if (It == PointsToMap.end())
+    return;
+
+  // Pointees recorded under every path that overlaps the query's (see
+  // collectPointees).
+  const auto &PathToPointee = It->second;
+  const PointeeListTy *Only = nullptr;
+  const unsigned NumMatching =
+      countOverlappingLists(PathToPointee, Pointer.Path, Only);
+  if (NumMatching == 0)
+    return;
+
+  // One list matches (an object with a single stored path -- almost every
+  // one): walk it where it is. This used to copy it into a fresh set, an
+  // allocation per element, on every query; the copy of a list with one
+  // source has the source's order (a SmallSet keeps insertion order up to
+  // four elements and is sorted beyond, and a copy passes through the same
+  // states), so the walk sees what it always saw.
+  if (NumMatching == 1 && ClEAPointeeViews) {
+    ++NumEAPointeeViews;
+    walkList(Pointer.Obj, *Only, Action);
+    return;
+  }
+
+  // Several lists overlap the query (a whole-object query on an object with
+  // field entries, or a field query with a whole-object entry beside it):
+  // their union, built exactly as before, so the walk's order is the old one.
+  ++NumEAPointeeSnapshots;
+  PointeeListTy Union;
+  collectPointees(Pointer, Union);
+  for (const ObjAndPath &Pointee : Union)
+    Action(Pointee);
 }
 
