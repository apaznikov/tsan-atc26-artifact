diff --git a/llvm/test/Analysis/EscapeAnalysis/escape-pointee-chain.ll b/llvm/test/Analysis/EscapeAnalysis/escape-pointee-chain.ll
new file mode 100644
index 000000000000..a5d96ad00897
--- /dev/null
+++ b/llvm/test/Analysis/EscapeAnalysis/escape-pointee-chain.ll
@@ -0,0 +1,117 @@
+; The points-to closure over a chain of call results, with the state's two
+; compile-time cuts on (the default) and off. Linking the chain back to front
+; makes every link's closure walk the links already made (b -> c finds c -> d,
+; a -> b finds b -> c -> d); publishing the head before the chain is built makes
+; every step of that walk an escape-marking walk of its own (the shape of
+; vk_safe_struct_utils' pNext chain); the struct with a whole-object slot and a
+; field slot is the one case where a query overlaps two stored lists. Off, the
+; old code paths run: every pointee list copied before it is walked, every
+; closure step and walk node taken. The printed states, the instrumentation and
+; the statistics must not depend on the setting.
+
+; RUN: opt < %s -passes='print<escape-analysis-global>' -disable-output 2>&1 | FileCheck %s
+; RUN: opt < %s -passes='print<escape-analysis-global>' -disable-output -tsan-ea-pointee-views=0 -tsan-ea-closure-cuts=0 2>&1 | FileCheck %s
+; RUN: opt < %s -passes='module(tsan-module),function(tsan)' -tsan-use-escape-analysis-global -S | FileCheck --check-prefix=TSAN %s
+; RUN: opt < %s -passes='module(tsan-module),function(tsan)' -tsan-use-escape-analysis-global -tsan-ea-pointee-views=0 -tsan-ea-closure-cuts=0 -S | FileCheck --check-prefix=TSAN %s
+; RUN: opt < %s -passes='print<escape-analysis-global>' -disable-output -stats 2>&1 | FileCheck --check-prefix=STATS %s
+; RUN: opt < %s -passes='print<escape-analysis-global>' -disable-output -stats -tsan-ea-pointee-views=0 -tsan-ea-closure-cuts=0 2>&1 | FileCheck --check-prefix=STATS-OFF %s
+; REQUIRES: asserts
+
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+
+declare noalias ptr @malloc(i64)
+
+; A chain nobody publishes: nothing escapes, the write through the head's
+; pointee is to a local.
+; CHECK: Printing analysis 'Escape Analysis' for function 'local_chain':
+; CHECK-NEXT: Printing analysis 'Escape Analysis' for function 'published_head_chain':
+; TSAN-LABEL: @local_chain
+; TSAN-NOT: call void @__tsan_write
+; TSAN: ret void
+define void @local_chain() sanitize_thread {
+entry:
+  %a = call ptr @malloc(i64 16)
+  %b = call ptr @malloc(i64 16)
+  %c = call ptr @malloc(i64 16)
+  %d = call ptr @malloc(i64 16)
+  store ptr %d, ptr %c
+  store ptr %c, ptr %b
+  store ptr %b, ptr %a
+  %pb = load ptr, ptr %a
+  store i32 1, ptr %pb
+  ret void
+}
+
+; The head is published first; every link then joins an escaped pointer, and
+; the closure carries the escape down the chain: d, linked last, is escaped
+; through a -> b -> c -> d.
+; CHECK: Escaping objects for BB entry:
+; CHECK-DAG: ptr %sink
+; CHECK-DAG: %a = call ptr @malloc(i64 16)
+; CHECK-DAG: %b = call ptr @malloc(i64 16)
+; CHECK-DAG: %c = call ptr @malloc(i64 16)
+; CHECK-DAG: %d = call ptr @malloc(i64 16)
+; CHECK-EMPTY:
+; TSAN-LABEL: @published_head_chain
+; TSAN: call void @__tsan_write4(ptr {{%d[0-9]*}})
+; TSAN: ret void
+define void @published_head_chain(ptr %sink) sanitize_thread {
+entry:
+  %a = call ptr @malloc(i64 16)
+  store ptr %a, ptr %sink
+  %b = call ptr @malloc(i64 16)
+  %c = call ptr @malloc(i64 16)
+  %d = call ptr @malloc(i64 16)
+  store ptr %d, ptr %c
+  store ptr %c, ptr %b
+  store ptr %b, ptr %a
+  store i32 2, ptr %d
+  ret void
+}
+
+; A whole-object slot and a field slot of the same struct: the walk from the
+; published struct takes the union of both lists.
+; CHECK: Printing analysis 'Escape Analysis' for function 'two_slots':
+; CHECK-NEXT: Escaping objects for BB entry:
+; CHECK-DAG: ptr %sink
+; CHECK-DAG: %s = call ptr @malloc(i64 16)
+; CHECK-DAG: %x = call ptr @malloc(i64 8)
+; CHECK-DAG: %y = call ptr @malloc(i64 8)
+; CHECK-EMPTY:
+; TSAN-LABEL: @two_slots
+; TSAN: call void @__tsan_write4(ptr {{%y[0-9]*}})
+; TSAN: ret void
+define void @two_slots(ptr %sink) sanitize_thread {
+entry:
+  %s = call ptr @malloc(i64 16)
+  %x = call ptr @malloc(i64 8)
+  %y = call ptr @malloc(i64 8)
+  %f1 = getelementptr { ptr, ptr }, ptr %s, i32 0, i32 1
+  store ptr %x, ptr %s
+  store ptr %y, ptr %f1
+  store ptr %s, ptr %sink
+  store i32 3, ptr %y
+  ret void
+}
+
+; The pairs: the two chains' 3 direct and 3 transitive each, sink -> a,
+; s -> x, s.1 -> y, sink -> s and its closure sink -> x, sink -> y. The two
+; copies are the two queries of the struct's whole object (the closure of
+; sink -> s and the walk from s), which overlap both of its lists; every other
+; query is answered in place. Each chain's closure meets d twice, once from c
+; and once from b: the second meeting is the skipped edge. Publishing the head
+; before the chain makes the closure of a -> b mark d, then c (d below it,
+; pruned), then b (c and d pruned); the fourth prune is sink's closure marking
+; s after the walk from s. Off, the walk takes those four nodes too.
+; STATS-DAG: 8 ea - Escape analysis: pointee lists walked in place
+; STATS-DAG: 2 ea - Escape analysis: pointee lists copied
+; STATS-DAG: 18 ea - Escape analysis: points-to pairs added by addPointsTo
+; STATS-DAG: 2 ea - Escape analysis: closure edges to an object already reached
+; STATS-DAG: 10 ea - Escape analysis: nodes visited by the escape-marking walks
+; STATS-DAG: 4 ea - Escape analysis: escape-marking subtrees pruned
+; STATS-OFF-NOT: pointee lists walked in place
+; STATS-OFF-NOT: closure edges to an object already reached
+; STATS-OFF-NOT: escape-marking subtrees pruned
+; STATS-OFF-DAG: 11 ea - Escape analysis: pointee lists copied
+; STATS-OFF-DAG: 18 ea - Escape analysis: points-to pairs added by addPointsTo
+; STATS-OFF-DAG: 14 ea - Escape analysis: nodes visited by the escape-marking walks
