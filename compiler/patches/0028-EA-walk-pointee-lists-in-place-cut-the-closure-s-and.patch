+void EscapeAnalysisInfo::forEachPointeeOver(
+    const EscapeState &Base, const StateJournal &J, const ObjAndPath &Pointer,
+    function_ref<void(const ObjAndPath &)> Action) {
+  const PointsToRelTy &BasePT = Base.getPointsTo();
+  const auto *BM = BasePT.pathMap(Pointer.Obj);
+  const auto *JM = J.AddedPT.pathMap(Pointer.Obj);
+  // Only one of the two relations knows the object: its own rule applies
+  // (one overlapping list in place, several as their union), and its order
+  // is the materialised state's -- StateJournal::collectPointees inserts
+  // exactly that relation's overlapping lists, in path order.
+  if (!JM) {
+    if (BM)
+      BasePT.forEachPointee(Pointer, Action);
+    return;
+  }
+  if (!BM) {
+    J.AddedPT.forEachPointee(Pointer, Action);
+    return;
+  }
+  // Both know the object. Exactly one stored list, of either, overlapping
+  // the query is walked in place: the materialised list would be a copy of
+  // it (the journal's pairs are not in the base, so under one path the
+  // materialised list is the base's list with the journal's appended --
+  // here one of the two is empty). Two or more lists -- the same path in
+  // both, or a whole-object list beside a field list -- are the union in
+  // the materialised state's order, built as collectPointees builds it.
+  if (ClEAPointeeViews) {
+    const PointsToRelTy *Owner = nullptr;
+    const PointsToRelTy::PointeeListTy *Only = nullptr;
+    unsigned NumMatching = countOverlappingLists(*BM, Pointer.Path, Only);
+    if (NumMatching)
+      Owner = &BasePT;
+    if (const unsigned InJournal =
+            countOverlappingLists(*JM, Pointer.Path, Only)) {
+      NumMatching += InJournal;
+      Owner = &J.AddedPT;
+    }
+    if (NumMatching == 0)
+      return;
+    if (NumMatching == 1) {
+      ++NumEAPointeeViews;
+      Owner->walkList(Pointer.Obj, *Only, Action);
+      return;
+    }
+  }
+  ++NumEAPointeeSnapshots;
+  PointsToRelTy::PointeeListTy Union;
+  J.collectPointees(Base, Pointer, Union);
+  for (const ObjAndPath &Pointee : Union)
+    Action(Pointee);
+}
+
