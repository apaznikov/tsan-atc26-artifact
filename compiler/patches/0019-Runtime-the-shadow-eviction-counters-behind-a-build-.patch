--- a/compiler-rt/lib/tsan/rtl/tsan_rtl.h
+++ b/compiler-rt/lib/tsan/rtl/tsan_rtl.h
@@ -265,6 +265,13 @@ struct ThreadState {
 
   explicit ThreadState(Tid tid);
 
+#if TSAN_EVICTION_STATS
