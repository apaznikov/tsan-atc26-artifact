+#if TSAN_EVICTION_STATS
+// Adds the eviction counters of a thread that is still running (its
+// ThreadState still exists) to the sums; finished threads already handed
+// theirs to Context in ThreadContext::OnFinished.
+static void SumLiveEvictionCounters(ThreadContextBase *tctx_base, void *arg) {
+  auto *tctx = static_cast<ThreadContext *>(tctx_base);
+  if (tctx->status != ThreadStatusRunning || !tctx->thr)
+    return;
+  u64 *sum = static_cast<u64 *>(arg);
+  sum[0] += tctx->thr->evict_total;
+  sum[1] += tctx->thr->evict_concurrent_foreign;
+  sum[2] += tctx->thr->evict_concurrent_foreign_plain;
+}
+#endif
+
 int Finalize(ThreadState *thr) {
   bool failed = false;
 
@@ -839,14 +862,25 @@ int Finalize(ThreadState *thr) {
 #endif
   }
 
+#if TSAN_EVICTION_STATS
   if (flags()->print_evictions) {
+    // Finished threads handed their counts to ctx in OnFinished; the live
+    // ones (main included) still hold theirs. Both under the registry lock,
+    // so a thread cannot finish between the two reads. The live counters are
+    // read without synchronisation: aligned 8-byte loads, and this runtime
