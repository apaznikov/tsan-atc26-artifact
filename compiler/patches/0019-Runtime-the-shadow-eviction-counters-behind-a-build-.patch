 #endif
@@ -344,20 +351,6 @@ struct Context {
   Mutex report_mtx;
   int nreported;
   atomic_uint64_t last_symbolize_time_ns;
-  // Shadow-cell evictions: every time CheckRaces found no empty or
-  // rewritable slot and overwrote a random one, and the subset where the
-  // overwritten access belonged to another thread and was not ordered
-  // before the current one -- the case that can hide a later race.
-  atomic_uint64_t evict_total;
-  atomic_uint64_t evict_concurrent_foreign;
-  atomic_uint64_t evict_concurrent_foreign_plain;
-  // Per-granule counters for the addresses named in evict_watch.
-  static const int kEvictWatchMax = 8;
-  uptr evict_watch_addr[kEvictWatchMax];
-  int evict_watch_n;
-  atomic_uint64_t evict_watch_total[kEvictWatchMax];
-  atomic_uint64_t evict_watch_foreign[kEvictWatchMax];
-  atomic_uint64_t evict_watch_plain[kEvictWatchMax];
 
   void *background_thread;
   atomic_uint32_t stop_background_thread;
@@ -426,6 +419,27 @@ struct Context {
   uptr mapped_shadow_begin;
   uptr mapped_shadow_end;
 #endif
+#if TSAN_EVICTION_STATS
+  // Shadow-cell evictions: every time CheckRaces found no empty or
+  // rewritable slot and overwrote a random one, and the subset where the
+  // overwritten access belonged to another thread and was not ordered
+  // before the current one -- the case that can hide a later race. Threads
+  // count in their ThreadState and hand the totals over here when they
+  // finish (ThreadContext::OnFinished); Finalize adds the live threads'.
+  atomic_uint64_t evict_total;
+  atomic_uint64_t evict_concurrent_foreign;
+  atomic_uint64_t evict_concurrent_foreign_plain;
+  // True when the out-of-line part of NoteEviction has work to do
+  // (evict_watch or trace_evictions); set once in Initialize.
+  bool evict_slow;
+  // Per-granule counters for the addresses named in evict_watch.
+  static const int kEvictWatchMax = 8;
+  uptr evict_watch_addr[kEvictWatchMax];
+  int evict_watch_n;
+  atomic_uint64_t evict_watch_total[kEvictWatchMax];
+  atomic_uint64_t evict_watch_foreign[kEvictWatchMax];
+  atomic_uint64_t evict_watch_plain[kEvictWatchMax];
+#endif
 };
 
 extern Context *ctx;  // The one and the only global runtime context.
diff --git a/compiler-rt/lib/tsan/rtl/tsan_rtl_access.cpp b/compiler-rt/lib/tsan/rtl/tsan_rtl_access.cpp
index ac58a48508b4..2f2c5bcbfd18 100644
--- a/compiler-rt/lib/tsan/rtl/tsan_rtl_access.cpp
+++ b/compiler-rt/lib/tsan/rtl/tsan_rtl_access.cpp
@@ -171,41 +171,44 @@ NOINLINE void DoReportRace(ThreadState* thr, RawShadow* shadow_mem, Shadow cur,
     SlotLock(thr);
 }
 
-// Called only on the slow path where no slot was empty or rewritable.
-// "Concurrent foreign": the overwritten access belongs to another thread and
-// the current thread's clock does not cover it, so it could still have raced
-// with a later conflicting access. The atomic reads the mutex interceptors
-// issue on the mutex word are the bulk of these in lock-heavy code and can
-// only race with a plain access to the mutex itself; the "plain" subset
-// excludes them.
-static NOINLINE void NoteEviction(ThreadState* thr, RawShadow* shadow_mem,
-                                  Shadow old, Shadow cur) {
-  atomic_fetch_add(&ctx->evict_total, 1, memory_order_relaxed);
+#if TSAN_EVICTION_STATS
+// Shadow-cell eviction counters (COMPILER_RT_TSAN_EVICTION_STATS). Called
+// only on the slow path where no slot was empty or rewritable. "Concurrent
+// foreign": the overwritten access belongs to another thread and the current
+// thread's clock does not cover it, so it could still have raced with a
+// later conflicting access. The atomic reads the mutex interceptors issue on
+// the mutex word are the bulk of these in lock-heavy code and can only race
+// with a plain access to the mutex itself; the "plain" subset excludes them.
+//
+// The counters are per thread and plain (ThreadState; handed to Context when
+// the thread finishes): a shared counter was a lock-prefixed increment on one
+// cache line at every eviction, and the out-of-line call it sat in cost every
+// access callback a callee-saved prologue on the path that evicts nothing.
+// Only the rare work -- the per-granule watch and the trace line -- is out of
+// line, and it is the last thing on the path.
+// preserve_most: the callee saves every register the caller might hold, so
+// the access callbacks this is inlined into need no callee-saved prologue
+// for the sake of this call.
+static NOINLINE __attribute__((preserve_most)) void NoteEvictionSlow(
+    ThreadState* thr, RawShadow* shadow_mem, Shadow old, Shadow cur) {
   // Watched granules: the application address of this shadow cell.
   int w = -1;
-  if (UNLIKELY(ctx->evict_watch_n)) {
-    const uptr app = ShadowToMem(shadow_mem) & ~(uptr)7;
-    for (int i = 0; i < ctx->evict_watch_n; i++)
-      if (ctx->evict_watch_addr[i] == app) {
-        w = i;
-        atomic_fetch_add(&ctx->evict_watch_total[i], 1, memory_order_relaxed);
-        break;
-      }
-  }
+  const uptr app = ShadowToMem(shadow_mem) & ~(uptr)7;
+  for (int i = 0; i < ctx->evict_watch_n; i++)
+    if (ctx->evict_watch_addr[i] == app) {
+      w = i;
+      atomic_fetch_add(&ctx->evict_watch_total[i], 1, memory_order_relaxed);
+      break;
+    }
   if (old.sid() == cur.sid() || thr->clock.Get(old.sid()) >= old.epoch())
     return;
-  atomic_fetch_add(&ctx->evict_concurrent_foreign, 1, memory_order_relaxed);
-  if (w >= 0)
-    atomic_fetch_add(&ctx->evict_watch_foreign[w], 1, memory_order_relaxed);
   const bool atomic = old.IsAtomic();
-  const bool plain = !atomic;
-  if (plain) {
-    atomic_fetch_add(&ctx->evict_concurrent_foreign_plain, 1,
-                     memory_order_relaxed);
-    if (w >= 0)
+  if (w >= 0) {
+    atomic_fetch_add(&ctx->evict_watch_foreign[w], 1, memory_order_relaxed);
+    if (!atomic)
       atomic_fetch_add(&ctx->evict_watch_plain[w], 1, memory_order_relaxed);
   }
-  if (UNLIKELY(flags()->trace_evictions))
+  if (flags()->trace_evictions)
     Printf("ThreadSanitizer: evicted concurrent %s %s at %p "
            "(tid=%d clock[%d]=%d; evicted sid=%d epoch=%d)\n",
            atomic ? "atomic" : "plain",
@@ -216,6 +219,19 @@ static NOINLINE void NoteEviction(ThreadState* thr, RawShadow* shadow_mem,
            static_cast<int>(old.sid()), static_cast<int>(old.epoch()));
 }
 
+ALWAYS_INLINE void NoteEviction(ThreadState* thr, RawShadow* shadow_mem,
+                                Shadow old, Shadow cur) {
+  thr->evict_total++;
+  if (old.sid() != cur.sid() && thr->clock.Get(old.sid()) < old.epoch()) {
+    thr->evict_concurrent_foreign++;
+    if (!old.IsAtomic())
+      thr->evict_concurrent_foreign_plain++;
+  }
+  if (UNLIKELY(ctx->evict_slow))
+    NoteEvictionSlow(thr, shadow_mem, old, cur);
+}
+#endif
+
 #if !TSAN_VECTORIZE
 ALWAYS_INLINE
 bool ContainsSameAccess(RawShadow* s, Shadow cur, int unused0, int unused1,
@@ -275,8 +291,13 @@ bool CheckRaces(ThreadState* thr, RawShadow* shadow_mem, Shadow cur,
   // Choose a random candidate slot and replace it.
   uptr index =
       atomic_load_relaxed(&thr->trace_pos) / sizeof(Event) % kShadowCnt;
-  NoteEviction(thr, shadow_mem, Shadow(LoadShadow(&shadow_mem[index])), cur);
+#if TSAN_EVICTION_STATS
+  Shadow old(LoadShadow(&shadow_mem[index]));
+#endif
   StoreShadow(&shadow_mem[index], cur.raw());
+#if TSAN_EVICTION_STATS
+  NoteEviction(thr, shadow_mem, old, cur);
+#endif
   return false;
 }
 
@@ -394,11 +415,18 @@ STORE : {
     const m128 empty = _mm_cmpeq_epi32(shadow, zero);
     const int empty_mask = _mm_movemask_epi8(empty);
     index = __builtin_ffs(empty_mask);
+#if TSAN_EVICTION_STATS
     if (UNLIKELY(index == 0)) {
       index = (atomic_load_relaxed(&thr->trace_pos) / 2) % 16;
-      NoteEviction(thr, shadow_mem,
-                   Shadow(LoadShadow(&shadow_mem[index / 4])), cur);
+      Shadow old(LoadShadow(&shadow_mem[index / 4]));
+      StoreShadow(&shadow_mem[index / 4], cur.raw());
+      NoteEviction(thr, shadow_mem, old, cur);
+      return false;
     }
+#else
+    if (UNLIKELY(index == 0))
+      index = (atomic_load_relaxed(&thr->trace_pos) / 2) % 16;
+#endif
   }
   StoreShadow(&shadow_mem[index / 4], cur.raw());
   // We could zero other slots determined by rewrite_mask.
diff --git a/compiler-rt/lib/tsan/rtl/tsan_rtl_thread.cpp b/compiler-rt/lib/tsan/rtl/tsan_rtl_thread.cpp
index 24bab5a66534..f81bcae06c1b 100644
--- a/compiler-rt/lib/tsan/rtl/tsan_rtl_thread.cpp
+++ b/compiler-rt/lib/tsan/rtl/tsan_rtl_thread.cpp
@@ -276,6 +276,16 @@ void ThreadContext::OnFinished() {
   // From now on replay will use trace->final_pos.
   trace.final_pos = (Event *)atomic_load_relaxed(&thr->trace_pos);
   atomic_store_relaxed(&thr->trace_pos, 0);
+#if TSAN_EVICTION_STATS
+  // Hand this thread's eviction counts to the process totals: three atomic
+  // adds per thread lifetime instead of one per eviction. Under the registry
+  // lock, so Finalize's walk over live threads cannot count them twice.
+  atomic_fetch_add(&ctx->evict_total, thr->evict_total, memory_order_relaxed);
+  atomic_fetch_add(&ctx->evict_concurrent_foreign,
+                   thr->evict_concurrent_foreign, memory_order_relaxed);
+  atomic_fetch_add(&ctx->evict_concurrent_foreign_plain,
+                   thr->evict_concurrent_foreign_plain, memory_order_relaxed);
+#endif
   thr->tctx = nullptr;
   thr = nullptr;
 }
