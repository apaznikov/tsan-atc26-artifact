diff --git a/compiler-rt/lib/tsan/rtl/CMakeLists.txt b/compiler-rt/lib/tsan/rtl/CMakeLists.txt
index 3bfc34ca9441..27066ef99f99 100644
--- a/compiler-rt/lib/tsan/rtl/CMakeLists.txt
+++ b/compiler-rt/lib/tsan/rtl/CMakeLists.txt
@@ -17,6 +17,16 @@ if(COMPILER_RT_TSAN_REX_FILTER)
   list(APPEND TSAN_RTL_CFLAGS -DTSAN_REX_FILTER=1)
 endif()
 
+# The shadow-eviction counters (the bounded-shadow measurement) are off by
+# default too: counted per thread they still add work to the access callbacks'
+# eviction branch, and the shipped runtime's access path must be upstream's.
+# See NoteEviction in tsan_rtl_access.cpp.
+option(COMPILER_RT_TSAN_EVICTION_STATS
+  "Compile the shadow-eviction counters into the TSan runtime" OFF)
+if(COMPILER_RT_TSAN_EVICTION_STATS)
+  list(APPEND TSAN_RTL_CFLAGS -DTSAN_EVICTION_STATS=1)
+endif()
+
 set(TSAN_RTL_DYNAMIC_CFLAGS ${TSAN_RTL_CFLAGS})
 list(REMOVE_ITEM TSAN_RTL_DYNAMIC_CFLAGS -fPIE)
 
