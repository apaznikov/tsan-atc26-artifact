diff --git a/compiler-rt/test/tsan/shadow_evictions.c b/compiler-rt/test/tsan/shadow_evictions.c
index aaadbe66aa4d..c2d9401e8c86 100644
--- a/compiler-rt/test/tsan/shadow_evictions.c
+++ b/compiler-rt/test/tsan/shadow_evictions.c
@@ -6,8 +6,10 @@
 // ordered by the join in main, so the concurrent counts are zero and the
 // total is not; the interceptors' atomic reads on the mutex word are what
