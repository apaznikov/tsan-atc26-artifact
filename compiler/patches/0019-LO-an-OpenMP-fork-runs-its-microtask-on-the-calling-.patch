+/// Thread creators whose start routine runs only on the new thread. Not every
+/// known creator qualifies: __kmpc_fork_call and __kmpc_fork_teams run the
+/// microtask on the calling (master) thread as well as on the team, and a
+/// fiber started by __tsan_create_fiber runs on the same OS thread once it is
+/// switched to -- a routine handed to those may release, on the calling
+/// thread, a mutex the caller holds (LO-7).
+static bool startsRoutineOnNewThreadOnly(const Function &Callee) {
+  static const StringSet<> Names = {"pthread_create", "__pthread_create_2_1",
+                                    "thrd_create"};
+  const StringRef Name = Callee.getName();
+  if (Names.contains(Name))
+    return true;
+  return llvm::any_of(ThreadCreatorPrefixes, [&Name](StringRef Prefix) {
+    return Name.starts_with(Prefix);
+  });
+}
+
 /// Whether an opaque call could invoke \p F synchronously on the calling
 /// thread. An externally visible function can be called from anywhere. A
 /// local one only if its address is taken -- except as the start routine of
-/// a thread creator: that runs on the new thread, which cannot release a
-/// mutex the creating thread holds.
+/// a thread creator that runs it only on the new thread, which cannot release
+/// a mutex the creating thread holds.
 static bool mayBeCalledBack(const Function &F) {
   if (!TsanWholeProgram && !F.hasLocalLinkage())
     return true;
@@ -353,7 +370,7 @@ static bool mayBeCalledBack(const Function &F) {
       continue;
     if (CB && CB->isArgOperand(&U)) {
       const Function *Callee = CB->getCalledFunction();
-      if (Callee && isKnownThreadCreator(*Callee))
+      if (Callee && startsRoutineOnNewThreadOnly(*Callee))
         continue;
     }
     return true;
diff --git a/llvm/test/Analysis/LockOwnership/fork-call-runs-on-caller.ll b/llvm/test/Analysis/LockOwnership/fork-call-runs-on-caller.ll
new file mode 100644
index 000000000000..c1edd470e871
--- /dev/null
+++ b/llvm/test/Analysis/LockOwnership/fork-call-runs-on-caller.ll
@@ -0,0 +1,62 @@
+; A function whose address only goes to a thread creator is not called back
+; on the creating thread -- if the creator runs it only on the new thread.
+; An OpenMP fork runs its microtask on the calling thread as well, so the
+; lock @m the microtask takes and releases is released under @omp_user's
+; feet: the store to @G after the fork is not protected, and @G must not be
+; reported. The control hands its routine to pthread_create, which runs it
+; only on the new thread, so @m2 stays held across the call and @H is
+; protected under it in both threads.
+
+; RUN: opt < %s -passes='print<lock-ownership>' -disable-output 2>&1 | FileCheck %s --implicit-check-not='* G'
+
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+
+@m = internal global i64 0, align 8
+@m2 = internal global i64 0, align 8
+@G = internal global i32 0, align 4
+@H = internal global i32 0, align 4
+declare i32 @pthread_mutex_lock(ptr)
+declare i32 @pthread_mutex_unlock(ptr)
+declare void @__kmpc_fork_call(ptr, i32, ptr, ...)
+declare i32 @pthread_create(ptr, ptr, ptr, ptr)
+
+define internal void @microtask(ptr %gtid, ptr %btid) {
+  %l = call i32 @pthread_mutex_lock(ptr @m)
+  store i32 2, ptr @G, align 4
+  %u = call i32 @pthread_mutex_unlock(ptr @m)
+  ret void
+}
+
+define internal ptr @omp_user(ptr %a) {
+  %l = call i32 @pthread_mutex_lock(ptr @m)
+  call void (ptr, i32, ptr, ...) @__kmpc_fork_call(ptr null, i32 0, ptr @microtask)
+  store i32 1, ptr @G, align 4
+  %u = call i32 @pthread_mutex_unlock(ptr @m)
+  ret ptr null
+}
+
+define internal ptr @routine(ptr %a) {
+  %l = call i32 @pthread_mutex_lock(ptr @m2)
+  store i32 2, ptr @H, align 4
+  %u = call i32 @pthread_mutex_unlock(ptr @m2)
+  ret ptr null
+}
+
+define internal ptr @pt_user(ptr %a) {
+  %t = alloca i64, align 8
+  %l = call i32 @pthread_mutex_lock(ptr @m2)
+  %c = call i32 @pthread_create(ptr %t, ptr null, ptr @routine, ptr null)
+  store i32 1, ptr @H, align 4
+  %u = call i32 @pthread_mutex_unlock(ptr @m2)
+  ret ptr null
+}
+
+define i32 @main() {
+  %t = alloca i64, align 8
+  %c1 = call i32 @pthread_create(ptr %t, ptr null, ptr @omp_user, ptr null)
+  %c2 = call i32 @pthread_create(ptr %t, ptr null, ptr @pt_user, ptr null)
+  ret i32 0
+}
+
+; CHECK: Protected Global Variables
+; CHECK-DAG: * H
