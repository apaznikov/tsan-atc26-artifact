+bool EscapeAnalysisInfo::subsumes(const EscapeState &New,
+                                  const EscapeState &Old) {
+  const auto &NO = New.getEscObjs();
+  auto NI = NO.begin();
+  for (const auto &[OAP, Reason] : Old.getEscObjs()) {
+    while (NI != NO.end() && NI->first < OAP)
+      ++NI;
+    if (NI == NO.end() || !(NI->first == OAP) || (Reason & ~NI->second).any())
+      return false;
+  }
+  if (New.getPointsTo().size() < Old.getPointsTo().size())
+    return false;
+  bool AllIn = true;
+  Old.getPointsTo().forEachPairNotIn(
+      New.getPointsTo(),
+      [&](const ObjAndPath &, const ObjAndPath &) { AllIn = false; });
+  return AllIn;
+}
