+void EscapeAnalysisInfo::BlockState::forEachEscObj(
+    function_ref<void(const ObjAndPath &, EscReasonTy)> F) const {
+  StateJournal::Cursor C(*Base, Journal);
+  while (const auto *E = C.next())
+    F(E->first, E->second);
+}
+
+bool EscapeAnalysisInfo::BlockState::sameStateAs(const BlockState &O) const {
+  // On one base the journals are canonical: equal iff the states are.
+  if (Base == O.Base)
+    return Journal == O.Journal;
+  if (numEscObjs() != O.numEscObjs())
+    return false;
+  StateJournal::Cursor A(*Base, Journal), B(*O.Base, O.Journal);
+  for (;;) {
+    const auto *EA = A.next();
+    const auto *EB = B.next();
+    if (!EA || !EB) {
+      if (EA || EB)
+        return false;
+      break;
+    }
+    if (!(EA->first == EB->first) || EA->second != EB->second)
+      return false;
+  }
+  // Points-to: a journal's pairs are not in its base, so the sizes add, and
+  // equal sizes with one-way containment is equality.
+  const PointsToRelTy &PA = Base->getPointsTo(), &PB = O.Base->getPointsTo();
+  if (PA.size() + Journal.AddedPT.size() != PB.size() + O.Journal.AddedPT.size())
+    return false;
+  bool AllIn = true;
+  auto InO = [&](const ObjAndPath &Pointer, const ObjAndPath &Pointee) {
+    if (AllIn && !PB.containsPointsToPair(Pointer, Pointee) &&
+        !O.Journal.AddedPT.containsPointsToPair(Pointer, Pointee))
+      AllIn = false;
+  };
+  PA.forEachPair(InO);
+  if (AllIn)
+    Journal.AddedPT.forEachPair(InO);
+  return AllIn;
+}
