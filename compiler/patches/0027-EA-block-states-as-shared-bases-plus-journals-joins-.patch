+std::optional<EscapeAnalysisInfo::EscReasonTy>
+EscapeAnalysisInfo::StateJournal::find(const EscapeState &Base,
+                                       const ObjAndPath &OAP) const {
+  if (const auto It = Set.find(OAP); It != Set.end())
+    return It->second;
+  if (!Erased.empty() && Erased.count(OAP))
+    return std::nullopt;
+  const auto &BaseObjs = Base.getEscObjs();
+  if (const auto It = BaseObjs.find(OAP); It != BaseObjs.end())
+    return It->second;
+  return std::nullopt;
+}
+
+EscapeAnalysisInfo::EscReasonTy
+EscapeAnalysisInfo::StateJournal::getEscReason(const EscapeState &Base,
+                                               const ObjAndPath &OAP) const {
+  // EscapeState::getEscReason over the materialised state: every entry of
+  // the object whose path overlaps the query, OR'd; a base entry the journal
+  // erased or replaced is left out.
+  EscReasonTy Reason;
+  const auto &BaseObjs = Base.getEscObjs();
+  for (auto It = BaseObjs.lower_bound({OAP.Obj, EmptyFieldPath});
+       It != BaseObjs.end() && It->first.Obj == OAP.Obj; ++It)
+    if (pathsOverlap(It->first.Path, OAP.Path) &&
+        (Erased.empty() || !Erased.count(It->first)) &&
+        (Set.empty() || !Set.count(It->first)))
+      Reason |= It->second;
+  for (auto It = Set.lower_bound({OAP.Obj, EmptyFieldPath});
+       It != Set.end() && It->first.Obj == OAP.Obj; ++It)
+    if (pathsOverlap(It->first.Path, OAP.Path))
+      Reason |= It->second;
+  return Reason;
+}
+
+void EscapeAnalysisInfo::StateJournal::collectPointees(
+    const EscapeState &Base, const ObjAndPath &Pointer,
+    PointsToRelTy::PointeeListTy &Out) const {
+  // Path by path in path order, the base's pointees before the journal's
+  // under each: the order the materialised state lists them in (a small
+  // SmallSet iterates in insertion order, and the transfer visits pointees
+  // in the order it is given them).
+  const auto *BM = Base.getPointsTo().pathMap(Pointer.Obj);
+  const auto *JM = AddedPT.pathMap(Pointer.Obj);
+  if (!JM) {
+    if (BM)
+      Base.getPointsTo().collectPointees(Pointer, Out);
+    return;
+  }
+  if (!BM) {
+    AddedPT.collectPointees(Pointer, Out);
+    return;
+  }
+  auto BI = BM->begin(), BE = BM->end(), JI = JM->begin(), JE = JM->end();
+  while (BI != BE || JI != JE) {
+    if (JI == JE || (BI != BE && BI->first < JI->first)) {
+      if (pathsOverlap(BI->first, Pointer.Path))
+        Out.insert(BI->second.begin(), BI->second.end());
+      ++BI;
+    } else if (BI == BE || JI->first < BI->first) {
+      if (pathsOverlap(JI->first, Pointer.Path))
+        Out.insert(JI->second.begin(), JI->second.end());
+      ++JI;
+    } else {
+      if (pathsOverlap(BI->first, Pointer.Path)) {
+        Out.insert(BI->second.begin(), BI->second.end());
+        Out.insert(JI->second.begin(), JI->second.end());
+      }
+      ++BI;
+      ++JI;
+    }
+  }
+}
