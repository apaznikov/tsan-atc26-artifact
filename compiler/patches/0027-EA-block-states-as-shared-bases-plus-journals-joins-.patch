+std::optional<EscapeAnalysisInfo::StateJournal>
+EscapeAnalysisInfo::updateJoinCache(JoinCache &C,
+                                    ArrayRef<const BlockState *> Preds,
+                                    unsigned BaseIdx) {
+  // The union of the predecessors' out-states is the union of the last
+  // evaluation's and the out-states that changed since, provided each of
+  // those grew: everything it contributed before, it still contributes, so
+  // nothing has to be taken out. On the same base, growth is read off the
+  // two journals (fewer erasures, more entries and bits, more pairs); on a
+  // new base it is checked on the two materialised states. Anything else
+  // -- an entry or a pair gone, a bit gone, the join's own base changed --
+  // recomputes from scratch.
+  if (C.Preds.size() != Preds.size() || C.Base != Preds[BaseIdx]->Base)
+    return std::nullopt;
+  const EscapeState &B = *C.Base;
+  StateJournal J = C.InJournal;
+  SmallVector<unsigned, 8> Changed;
+  // (pointer, path) sets that received a new element: their order is
+  // rebuilt below from every predecessor's, in predecessor order, as the
+  // from-scratch fold fills them.
+  std::set<std::pair<const Value *, FieldPathTy>> Affected;
+  auto NewPair = [&](const ObjAndPath &Pointer) {
+    Affected.emplace(Pointer.Obj, Pointer.Path);
+  };
+  for (unsigned I = 0; I < Preds.size(); ++I) {
+    const BlockState &P = *Preds[I];
+    const JoinCache::PredEntry &E = C.Preds[I];
+    if (P.Version == E.Version)
+      continue;
+    Changed.push_back(I);
+    const auto &OldBase = E.Base;
+    if (P.Base != OldBase) {
+      EscapeState OldState(*OldBase);
+      OldState.applyJournal(E.Journal);
+      const auto NewState = materialise(P);
+      if (!subsumes(*NewState, OldState))
+        return std::nullopt;
+      foldStateInto(J, B, *NewState, {}, NewPair);
+      continue;
+    }
+    const StateJournal &N = P.Journal, &O = E.Journal;
+    const auto &PBase = P.Base->getEscObjs();
+    // Erasures that went away: those entries are back, with the value the
+    // journal gives them or the base's.
+    for (const ObjAndPath &OAP : O.Erased) {
+      if (N.Erased.count(OAP))
+        continue;
+      const auto NIt = N.Set.find(OAP);
+      J.fold(B, OAP, NIt != N.Set.end() ? NIt->second : PBase.find(OAP)->second);
+    }
+    if (N.Erased.size() > O.Erased.size())
+      return std::nullopt; // a new erasure
+    for (const ObjAndPath &OAP : N.Erased)
+      if (!O.Erased.count(OAP))
+        return std::nullopt;
+    unsigned NewKeys = 0;
+    for (const auto &[OAP, Reason] : N.Set) {
+      if (const auto OIt = O.Set.find(OAP); OIt != O.Set.end()) {
+        if ((OIt->second & ~Reason).any())
+          return std::nullopt; // a reason bit went away
+        if (Reason != OIt->second)
+          J.fold(B, OAP, Reason);
+        continue;
+      }
+      ++NewKeys;
+      // A base entry now in the journal must have grown, not been replaced.
+      if (const auto BIt = PBase.find(OAP);
+          BIt != PBase.end() && (BIt->second & ~Reason).any())
+        return std::nullopt;
+      J.fold(B, OAP, Reason);
+    }
+    if (N.Set.size() - NewKeys != O.Set.size())
+      return std::nullopt; // an entry went away
+    unsigned NewPairs = 0;
+    N.AddedPT.forEachPairNotIn(O.AddedPT, [&](const ObjAndPath &Pointer,
+                                              const ObjAndPath &Pointee) {
+      ++NewPairs;
+      if (!B.containsPointsToPair(Pointer, Pointee) &&
+          J.AddedPT.addPointsToPair(Pointer, Pointee))
+        NewPair(Pointer);
+    });
+    if (N.AddedPT.size() - NewPairs != O.AddedPT.size())
+      return std::nullopt; // a pair went away
+  }
+  for (const auto &[Obj, Path] : Affected) {
+    const PointsToRelTy::PointeeListTy *BSet = nullptr;
+    if (const auto *BM = B.getPointsTo().pathMap(Obj))
+      if (const auto It = BM->find(Path); It != BM->end())
+        BSet = &It->second;
+    SmallVector<ObjAndPath, 8> Ordered;
+    auto Take = [&](const PointsToRelTy &PT) {
+      const auto *PM = PT.pathMap(Obj);
+      if (!PM)
+        return;
+      const auto It = PM->find(Path);
+      if (It == PM->end())
+        return;
+      for (const ObjAndPath &Pointee : It->second)
+        if ((!BSet || !BSet->contains(Pointee)) &&
+            !llvm::is_contained(Ordered, Pointee))
+          Ordered.push_back(Pointee);
+    };
+    // A predecessor's materialised set is its base's followed by its
+    // journal's.
+    for (const BlockState *P : Preds) {
+      if (P->Base.get() != &B)
+        Take(P->Base->getPointsTo());
+      Take(P->Journal.AddedPT);
+    }
+    J.AddedPT.reorderPointees(Obj, Path, Ordered);
+  }
+  for (unsigned I : Changed)
+    C.Preds[I] = {Preds[I]->Base, Preds[I]->Version, Preds[I]->Journal};
+  C.InJournal = J;
+  return J;
+}
