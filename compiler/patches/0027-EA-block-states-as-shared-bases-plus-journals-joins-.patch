+      EscapedObjectsTy::const_iterator BI, BE, SI, SE;
+      const std::set<ObjAndPath> *Erased;
+      Cursor(const EscapeState &Base, const StateJournal &J);
+      const EscapedObjectsTy::value_type *next();
