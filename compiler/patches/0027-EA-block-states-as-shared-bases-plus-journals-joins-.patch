+  /// A join with many predecessors is evaluated once per predecessor that
+  /// changes; this remembers its in-state and what every predecessor
+  /// contributed, so that the next evaluation folds only the predecessors
+  /// that changed since (see mergePredEscapeStates).
+  struct JoinCache {
+    std::shared_ptr<const EscapeState> Base;
+    StateJournal InJournal;
+    struct PredEntry {
+      /// Strong: a predecessor's superseded base stays alive until the
