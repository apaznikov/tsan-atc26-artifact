+void EscapeAnalysisInfo::foldStateInto(
+    StateJournal &J, const EscapeState &B, const EscapeState &X,
+    const std::set<ObjAndPath> &Skip,
+    function_ref<void(const ObjAndPath &)> OnNewPair) {
+  const auto &XO = X.getEscObjs(), &BO = B.getEscObjs();
+  auto BI = BO.begin();
+  auto SI = J.Set.begin();
+  auto EI = J.Erased.begin();
+  for (const auto &[OAP, Reason] : XO) {
+    if (!Skip.empty() && Skip.count(OAP))
+      continue;
+    while (BI != BO.end() && BI->first < OAP)
+      ++BI;
+    while (SI != J.Set.end() && SI->first < OAP)
+      ++SI;
+    while (EI != J.Erased.end() && *EI < OAP)
+      ++EI;
+    const bool InSet = SI != J.Set.end() && SI->first == OAP;
+    const bool InErased = EI != J.Erased.end() && *EI == OAP;
+    if (!InSet && !InErased && BI != BO.end() && BI->first == OAP &&
+        (Reason & ~BI->second).none())
+      continue;
+    // fold may erase the journal entry the iterators are on.
+    if (InSet)
+      ++SI;
+    if (InErased)
+      ++EI;
+    J.fold(B, OAP, Reason);
+  }
+  X.getPointsTo().forEachPairNotIn(
+      B.getPointsTo(), [&](const ObjAndPath &Pointer, const ObjAndPath &Pointee) {
+        if (J.AddedPT.addPointsToPair(Pointer, Pointee))
+          OnNewPair(Pointer);
+      });
+}
