+/// EscapeState::addEscObjOrReason, step for step, over the view.
+void EscapeAnalysisInfo::StateView::addEscObjOrReason(const ObjAndPath &OAP,
+                                                      EscReasonTy EscReason,
+                                                      const Instruction *I) {
+  LLVM_DEBUG(dbgs() << "\t\t\t\taddEscapeObjOrReason: " << dbgObjToStr(OAP.Obj)
+                    << dbgPathToStr(OAP.Path) << "\n\t\t\t\tNew EscReason: ";
+             printEscReason(EscReason););
+
+  const auto &BaseObjs = Base.getEscObjs();
+  if (const auto It = J.Set.find(OAP); It != J.Set.end()) {
+    // Object is already escaped - add the escape reason. A base entry a
+    // join had set below the base's value may grow back to it: then it is
+    // the base's entry again, and the journal stays canonical.
+    It->second |= EscReason;
+    if (const auto BIt = BaseObjs.find(OAP);
+        BIt != BaseObjs.end() && BIt->second == It->second)
+      J.Set.erase(It);
+    return;
+  }
+  const bool WasErased = !J.Erased.empty() && J.Erased.count(OAP);
+  if (!WasErased)
+    if (const auto BIt = BaseObjs.find(OAP); BIt != BaseObjs.end()) {
+      // Already escaped in the base: recorded only if the reason grows, so
+      // that the journal stays canonical.
+      if (const auto Grown = BIt->second | EscReason; Grown != BIt->second)
+        J.Set.emplace(OAP, Grown);
+      return;
+    }
+
+  // If object escapes by empty path, then it escapes by all paths
+  // 1. If the object has already escaped by EmptyFieldPath, do nothing
+  if (J.find(Base, {OAP.Obj, EmptyFieldPath}))
+    return;
+
+  // 2. If EmptyFieldPath is the new (current) path, then leave only it: the
+  // base's entries of the object are recorded erased, the journal's own are
+  // dropped.
+  if (OAP.Path == EmptyFieldPath) {
+    for (auto It = BaseObjs.lower_bound({OAP.Obj, EmptyFieldPath});
+         It != BaseObjs.end() && It->first.Obj == OAP.Obj; ++It)
+      J.Erased.insert(It->first);
+    for (auto It = J.Set.lower_bound({OAP.Obj, EmptyFieldPath});
+         It != J.Set.end() && It->first.Obj == OAP.Obj;) {
+      if (!BaseObjs.count(It->first))
+        --J.NumNewKeys;
+      It = J.Set.erase(It);
+    }
+  }
+  // Object has not escaped before - add it (a base entry can only be absent
+  // because it was erased: it comes back with this reason alone)
+  if (const auto BIt = BaseObjs.find(OAP); BIt != BaseObjs.end()) {
+    J.Erased.erase(OAP);
+    if (BIt->second != EscReason)
+      J.Set.emplace(OAP, EscReason);
+  } else {
+    ++J.NumNewKeys;
+    J.Set.emplace(OAP, EscReason);
+  }
+  debugPrintEscapingCallee(I, EscReason);
+}
