+                                    const ObjAndPath &OAP) const;
+    EscReasonTy getEscReason(const EscapeState &Base,
+                             const ObjAndPath &OAP) const;
+    void collectPointees(const EscapeState &Base, const ObjAndPath &Pointer,
+                         PointsToRelTy::PointeeListTy &Out) const;
+
+    /// The materialised escaped set, entry by entry in key order, without
+    /// building it.
