+EscapeAnalysisInfo::StateJournal::Cursor::Cursor(const EscapeState &Base,
+                                                 const StateJournal &J)
+    : BI(Base.getEscObjs().begin()), BE(Base.getEscObjs().end()),
+      SI(J.Set.begin()), SE(J.Set.end()),
+      Erased(J.Erased.empty() ? nullptr : &J.Erased) {}
+
+const EscapeAnalysisInfo::EscapedObjectsTy::value_type *
+EscapeAnalysisInfo::StateJournal::Cursor::next() {
+  while (BI != BE || SI != SE) {
+    if (SI == SE || (BI != BE && BI->first < SI->first)) {
+      const auto *E = &*BI++;
+      if (Erased && Erased->count(E->first))
+        continue;
+      return E;
+    }
+    if (BI == BE || SI->first < BI->first)
+      return &*SI++;
+    // The same key in both: the journal's value.
+    ++BI;
+    return &*SI++;
+  }
+  return nullptr;
+}
