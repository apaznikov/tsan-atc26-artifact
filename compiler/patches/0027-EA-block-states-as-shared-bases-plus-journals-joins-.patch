+void EscapeAnalysisInfo::StateJournal::fold(const EscapeState &Base,
+                                            const ObjAndPath &OAP,
+                                            EscReasonTy Reason) {
+  const auto &BaseObjs = Base.getEscObjs();
+  if (const auto It = Set.find(OAP); It != Set.end()) {
+    It->second |= Reason;
+    // Back to the base's own value: not an entry of the journal.
+    if (const auto BIt = BaseObjs.find(OAP);
+        BIt != BaseObjs.end() && BIt->second == It->second)
+      Set.erase(It);
+    return;
+  }
+  if (!Erased.empty() && Erased.erase(OAP)) {
+    // A base entry every predecessor on the base excluded: this value
+    // replaces the base's.
+    if (BaseObjs.find(OAP)->second != Reason)
+      Set.emplace(OAP, Reason);
+    return;
+  }
+  if (const auto BIt = BaseObjs.find(OAP); BIt != BaseObjs.end()) {
+    if (const auto Grown = BIt->second | Reason; Grown != BIt->second)
+      Set.emplace(OAP, Grown);
+    return;
+  }
+  Set.emplace(OAP, Reason);
+  ++NumNewKeys;
+}
