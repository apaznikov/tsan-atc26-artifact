+void EscapeAnalysisInfo::BlockState::forEachPointeeDo(
+    const ObjAndPath &OAP,
+    const std::function<void(const ObjAndPath &)> &Action) const {
+  LLVM_DEBUG(dbgs() << "\t\t\tforEachPointeeDo: " << *OAP.Obj
+                    << dbgPathToStr(OAP.Path) << "\n";);
+  PointsToRelTy::PointeeListTy Pointees;
+  Journal.collectPointees(*Base, OAP, Pointees);
+  for (const ObjAndPath &Pointee : Pointees)
+    Action(Pointee);
+}
