+/// Development check for the shared-base representation of the block states
+/// (BlockState, StateJournal): at every block evaluation, also compute the
+/// in-state the old way (every predecessor's materialised out-state merged
+/// in turn) and run the transfer on a copy of it, and check that the
+/// shared-base join and the journal replayed on the base give the same state,
+/// the same return-escape bit and the same change verdict. Off by default;
+/// used by the gate runs.
+static cl::opt<bool> ClEAVerifyJournal(
+    "tsan-ea-verify-journal", cl::init(false), cl::Hidden,
+    cl::desc("Escape analysis: recompute every block evaluation from "
+             "materialised states and assert the journal representation "
+             "agrees (slow; for verification)"));
+
+/// A block with one predecessor takes that predecessor's base and a copy of
+/// its journal, so that a chain of blocks stays relative to the base it
+/// started from (the switch block's state, for a parser's cases) and a join
+/// over the chains sees one base; once the journal is larger than this, the
+/// block takes the predecessor's materialised state instead, so that a
+/// journal does not keep growing along a long chain or around a loop.
+static cl::opt<unsigned> ClEARebaseJournalEntries(
+    "tsan-ea-rebase-journal-entries", cl::init(64), cl::Hidden,
+    cl::desc("Escape analysis: a block with one predecessor copies the "
+             "predecessor's journal when it has at most this many entries "
+             "and takes its materialised state otherwise"));
+
+/// The same for a join: its in-state is materialised when the journal over
+/// the first predecessor's base is larger than this, so that neither its
+/// successors (which copy or fold the journal) nor its own next evaluation
+/// carry it around -- the parser's loop header, whose first predecessor is
+/// the entry block on the empty base and whose other predecessor brings the
+/// whole loop-carried state. Every materialisation is a base of its own,
+/// which the blocks evaluated against it keep alive; without this rule the
+/// extract takes five times longer (the successors re-base one by one).
+static cl::opt<unsigned> ClEARebaseJoinJournalEntries(
+    "tsan-ea-rebase-join-journal-entries", cl::init(64), cl::Hidden,
+    cl::desc("Escape analysis: a join materialises its in-state when its "
+             "journal has more than this many entries (0: never)"));
+
+/// A join with at least this many predecessors keeps its last in-state and
+/// folds only the predecessors that changed since (JoinCache).
+static cl::opt<unsigned> ClEAJoinCacheMinPreds(
+    "tsan-ea-join-cache-min-preds", cl::init(16), cl::Hidden,
+    cl::desc("Escape analysis: a join with at least this many predecessors "
+             "is updated incrementally between evaluations"));
+
