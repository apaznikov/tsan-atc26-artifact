+/// The state a block's transfer runs on inside the fixpoint: the block's
+/// base, shared and never written, and the journal that records this
+/// evaluation's effect on it. Reads answer what the materialised state would;
+/// writes go to the journal and keep it canonical (StateJournal).
+class EscapeAnalysisInfo::StateView {
+  const EscapeState &Base;
+  StateJournal &J;
+
+public:
+  StateView(const EscapeState &Base, StateJournal &J) : Base(Base), J(J) {}
+
+  EscReasonTy getEscReason(const ObjAndPath &OAP) const {
+    return J.getEscReason(Base, OAP);
+  }
+  std::optional<PointsToRelTy::PointeeListTy>
+  getPointees(const ObjAndPath &Pointer) const {
+    PointsToRelTy::PointeeListTy Result;
+    J.collectPointees(Base, Pointer, Result);
+    return Result.empty() ? std::nullopt : std::make_optional(Result);
+  }
+  bool containsPointsToPair(const ObjAndPath &Pointer,
+                            const ObjAndPath &Pointee) const {
+    return Base.containsPointsToPair(Pointer, Pointee) ||
+           J.AddedPT.containsPointsToPair(Pointer, Pointee);
+  }
+  void addPointsToPair(const ObjAndPath &Pointer, const ObjAndPath &Pointee) {
+    if (!Base.containsPointsToPair(Pointer, Pointee))
+      J.AddedPT.addPointsToPair(Pointer, Pointee);
+  }
+  void addEscObjOrReason(const ObjAndPath &OAP, EscReasonTy EscReason,
+                         const Instruction *I);
+
+  void addEscObj(const ObjAndPath &EscObj, EscReasonTy EscReason,
+                 const Instruction *I) {
+    addEscObjImpl(*this, EscObj, EscReason, I);
+  }
+  void addPointsTo(const UnderlObjTy &Pointer, const UnderlObjTy &Pointee,
+                   const EscapeAnalysisInfo *EAI, const Instruction *I) {
+    addPointsToImpl(*this, Pointer, Pointee, EAI, I);
+  }
+  void checkAndUpdEscStatus(const ObjAndPath &Pointer,
+                            const ObjAndPath &Pointee,
+                            const EscapeAnalysisInfo *EAI,
+                            const Instruction *I) {
+    checkAndUpdEscStatusImpl(*this, Pointer, Pointee, EAI, I);
+  }
+  void forEachPointeeDo(
+      const ObjAndPath &OAP,
+      const std::function<void(const ObjAndPath &)> &Action) const {
+    LLVM_DEBUG(dbgs() << "\t\t\tforEachPointeeDo: " << *OAP.Obj
+                      << dbgPathToStr(OAP.Path) << "\n";);
+    PointsToRelTy::PointeeListTy Pointees;
+    J.collectPointees(Base, OAP, Pointees);
+    for (const ObjAndPath &Pointee : Pointees)
+      Action(Pointee);
+  }
+};
