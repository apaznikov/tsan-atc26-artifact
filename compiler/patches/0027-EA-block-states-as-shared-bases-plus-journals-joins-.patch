+  /// A state expressed relative to a base: what a block's transfer did to
+  /// the state it ran on, or what a join adds to the first predecessor's
+  /// base -- the effect, not the calls that produced it, and canonical with
+  /// respect to that base --
+  ///   Set      entries whose reason differs from the base's, with the
+  ///            reason the state has (it replaces the base's: new entries,
+  ///            base entries the transfer grew by OR, and base entries a
+  ///            join sets from other predecessors' values alone);
+  ///   Erased   base entries the state does not have: the field entries an
+  ///            escape by the whole object removes, and the entries every
+  ///            predecessor of a join dropped;
+  ///   AddedPT  points-to pairs the base does not have.
+  /// The base with the journal replayed is the state exactly, and two
+  /// journals on one base are equal iff the two states are.
+  struct StateJournal {
+    EscapedObjectsTy Set;
+    std::set<ObjAndPath> Erased;
+    PointsToRelTy AddedPT;
+    /// Entries of Set that are not in the base; the state has
+    /// Base.size() + NumNewKeys - Erased.size() entries.
+    unsigned NumNewKeys = 0;
+
+    bool empty() const {
+      return Set.empty() && Erased.empty() && AddedPT.empty();
+    }
+    unsigned numEntries() const {
+      return Set.size() + Erased.size() + AddedPT.size();
+    }
+    bool operator==(const StateJournal &O) const {
+      return Set == O.Set && Erased == O.Erased && AddedPT == O.AddedPT;
+    }
+    bool operator!=(const StateJournal &O) const { return !(*this == O); }
+
